	partition dim_policy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_policy.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"policy_id", type text}, {"customer_id", type text}, {"agent_id", type text}, {"vehicle_make", type text}, {"vehicle_model", type text}, {"vehicle_segment", type text}, {"fuel_type", type text}, {"vehicle_age_years", Int64.Type}, {"policy_type", type text}, {"zero_dep_addon", Int64.Type}, {"idv", type number}, {"ncb_percent", Int64.Type}, {"voluntary_deductible", Int64.Type}, {"annual_premium", type number}, {"policy_start_date", type date}, {"policy_end_date", type date}, {"is_renewal", Int64.Type}, {"is_new_business", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
