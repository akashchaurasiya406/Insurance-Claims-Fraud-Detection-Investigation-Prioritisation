table dim_agent
	lineageTag: 80eab306-5a67-529c-b662-98ad480e4f33

	column agent_id
		dataType: string
		lineageTag: 516e9ffc-fc3a-54c7-9e00-983455b87e18
		summarizeBy: none
		sourceColumn: agent_id

		annotation SummarizationSetBy = User

	column channel
		dataType: string
		lineageTag: b1621820-d3dc-5cd2-81ca-c696f05f69aa
		summarizeBy: none
		sourceColumn: channel

		annotation SummarizationSetBy = User

	column city
		dataType: string
		lineageTag: 5e80178c-75a7-5527-8d37-682b91110adc
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = User

	column state
		dataType: string
		lineageTag: 9acdebf4-9db0-5f0f-af3e-8d1113642647
		summarizeBy: none
		sourceColumn: state

		annotation SummarizationSetBy = User

	column years_experience
		dataType: int64
		formatString: 0
		lineageTag: a26886d7-b4de-56ff-ae91-84a52cfa5547
		summarizeBy: none
		sourceColumn: years_experience

		annotation SummarizationSetBy = User

	partition dim_agent = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_agent.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"agent_id", type text}, {"channel", type text}, {"city", type text}, {"state", type text}, {"years_experience", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
