	partition capacity_curve = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "capacity_curve.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"pct_reviewed", Int64.Type}, {"precision_at_capacity", type number}, {"recall_at_capacity", type number}, {"fraud_amount_caught", type number}, {"fraud_amount_recall", type number}, {"investigations", Int64.Type}, {"false_positives", Int64.Type}, {"fraud_savings", type number}, {"net_benefit", type number}, {"strategy", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
