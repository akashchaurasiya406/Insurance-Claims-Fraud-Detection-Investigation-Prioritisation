table feature_importance
	lineageTag: ff8a1b84-c8cd-56f8-b0bb-62dec0b9572f

	column feature
		dataType: string
		lineageTag: fb9e6d95-ce81-5c22-a461-7137dd6464a9
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = User

	column importance
		dataType: double
		formatString: 0.0000
		lineageTag: bf74c449-aff2-5ccd-a347-68cb83a9b4d8
		summarizeBy: none
		sourceColumn: importance

		annotation SummarizationSetBy = User

	column std
		dataType: double
		formatString: 0.0000
		lineageTag: f863f607-b895-5723-87c4-449b7e71ffb7
		summarizeBy: none
		sourceColumn: std

		annotation SummarizationSetBy = User

	partition feature_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "feature_importance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"feature", type text}, {"importance", type number}, {"std", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
