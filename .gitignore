# regenerated by run_pipeline.py
data/insurance_claims.db
data/raw/
data/processed/
models/*.joblib

# machine-specific CSV folder path; write it with: python src/build_powerbi_project.py --set-data-folder
powerbi/*.SemanticModel/definition/expressions.tmdl

# python / jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Power BI: the .pbip project is the source; a .pbix saved from it is a local binary copy
# (it embeds the machine-specific DataFolder path)
*.pbix
*.pbix.bak
~$*
# Power BI Project: per-user settings and local data cache (rebuilt on Refresh)
**/.pbi/localSettings.json
**/.pbi/cache.abf
